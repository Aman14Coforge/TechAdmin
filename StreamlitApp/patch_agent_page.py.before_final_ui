    st.session_state.security_dialog_query = (
        "Show today's non-compliant devices with missing patch count greater than zero"
    )


def render_patch_agent_page(
    claims: dict[str, Any],
    access: dict[str, Any],
) -> None:
    """Render the Security Agent workspace."""
    _init()
    conversation = st.session_state.security_conversation

    with st.container(key="security_content"):
        with st.container(key="security_greet_row"):
            header, action = st.columns([5, 1.45], vertical_alignment="center")

            with header:
                st.markdown(
                    '<div class="ta-greet">'
                    '<h1>Security Agent</h1>'
                    '<p>Investigate endpoint compliance, device patch history, '
                    'patch exposure, and remediation actions.</p>'
                    '</div>',
                    unsafe_allow_html=True,
                )

            with action:
                with st.container(key="security_new_conversation"):
                    if st.button(
                        "New conversation",
                        icon=":material/add_comment:",
                        width="stretch",
                        key="security_new_conversation_button",
                    ):
                        _new_security_conversation()
                        st.rerun()

        if st.session_state.pop("security_redirect_notice", False):
            st.info(
                "This request belongs to the Security Agent. TechAdmin moved the "
                "request here without executing it as an Identity Agent operation."
            )

        if not conversation:
            st.markdown(
                '<div class="ta-hello">'
                '<h3>Quick actions</h3>'
                '<p>Choose an operation, or describe the security task in the box below.</p>'
                '</div>',
                unsafe_allow_html=True,
            )

            quick_columns = st.columns(3, gap="medium")

            with quick_columns[0]:
                with st.container(key="security_quick_fleet"):
                    if st.button(
                        "Review patch compliance",
                        icon=":material/security:",
                        width="stretch",
                        key="security_quick_fleet_button",
                    ):
                        queue_security_fleet_snapshot()
                        st.rerun()
                    st.caption(
                        "Review the latest non-compliant devices and missing-patch counts."
                    )

            with quick_columns[1]:
                with st.container(key="security_quick_device"):
                    if st.button(
                        "Device patch history",
                        icon=":material/computer:",
                        width="stretch",
                        key="security_quick_device_button",
                    ):
                        security_device_history_dialog()
                    st.caption(
                        "Inspect missing patches and daily history for one device."
                    )

            with quick_columns[2]:
                with st.container(key="security_quick_patch"):
                    if st.button(
                        "Patch impact report",
                        icon=":material/analytics:",
                        width="stretch",
                        key="security_quick_patch_button",
                    ):
                        security_patch_report_dialog()
                    st.caption(
                        "Find every device affected by a specific patch or KB."
                    )

        for item in conversation:
            if item["role"] == "user":
                st.markdown(
                    '<div class="ta-user-row">'
                    '<div class="ta-user-bubble">'
                    '<div class="meta">You</div>'
                    f'<div class="txt">{escape(str(item["content"]))}</div>'
                    '</div>'
                    '</div>',
                    unsafe_allow_html=True,
                )
            else:
                _assistant(item, claims, access)

        pending = st.session_state.security_pending
        if isinstance(pending, dict):
            with st.container(key="security_approval_card"):
                st.warning(
                    "Approval is required before this live Security Agent operation runs."
                )
                approve_column, cancel_column = st.columns(2)

                if approve_column.button(
                    "Approve and run",
                    type="primary",
                    width="stretch",
                    key="security_approve",
                ):
                    _approve()
                    st.rerun()

                if cancel_column.button(
                    "Cancel", width="stretch", key="security_cancel"
                ):
                    audit_id = pending.get("audit_id")
                    if audit_id:
                        try:
                            SecurityQueryAudit.finish(
                                audit_id,
                                action=pending.get("parsed", {}).get("action"),
                                target=pending.get("parsed", {}).get("device_name"),
                                status="CANCELLED",
                                metadata=pending.get("parsed"),
                                summary={"message": "Cancelled by operator."},
                            )
                        except Exception:
                            pass

                    st.session_state.security_pending = None
                    _append(
                        "assistant",
                        {
                            "type": "message",
                            "message": "Cancelled. No changes were made.",
                        },
                    )
                    st.rerun()

    redirected_query = st.session_state.pop("patch_query_prefill", None)
    dialog_query = st.session_state.pop("security_dialog_query", None)
    typed_query = st.chat_input(
        "Ask the Security Agent about Ivanti or endpoint security…",
        key="security_chat_input",
    )
    submitted_query = typed_query or redirected_query or dialog_query

    if submitted_query:
        _execute(submitted_query, claims, access)
        st.rerun()
