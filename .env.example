# Gemini fallback API key — used only when the primary Ollama call fails.
# Never commit a real key here. All other LLM settings (model, temperature,
# top_p, timeout) already live in the existing Configs/llm_config.yaml.
GEMINI_API_KEY=

# Optional — override the Gemini fallback's own model/temperature/timeout.
# There is no `fallback:` section in the existing llm_config.yaml, so
# these default sensibly in code if left unset.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT=60
